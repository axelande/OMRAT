      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="labelMergingCf">
        <property name="text">
         <string>Merging causation factor:</string>
        </property>
        <property name="toolTip">
         <string>Applied to two routes through a waypoint that leave on the same leg.  Defaults to the crossing value; IWRAP publishes no separate figure.</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="leMergingCf">
        <property name="text">
         <string>1.3E-4</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="labelBendCf">
        <property name="text">
         <string>Bend causation factor:</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QLineEdit" name="leBendCf">
        <property name="text">
         <string>1.3E-4</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="labelMinEncounterAngle">
        <property name="text">
         <string>Smallest angle between routes at a waypoint:</string>
        </property>
        <property name="toolTip">
         <string>Crossing, merging and bend at a waypoint are counted only for two routes whose arrival courses differ by at least this angle and at most 180 degrees minus it (the crossing formula divides by sin of the angle).  A turn smaller than this angle gives no bend.  Default 10 degrees: the range of validity of Friis-Hansen's crossing equations (10-170 degrees) and IWRAP's limit.</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QDoubleSpinBox" name="sbMinEncounterAngle">
        <property name="toolTip">
         <string>Crossing, merging and bend at a waypoint are counted only for two routes whose arrival courses differ by at least this angle and at most 180 degrees minus it.  Default 10 degrees (Friis-Hansen's range of validity, IWRAP's limit).</string>
        </property>
        <property name="suffix">
         <string> deg</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="minimum">
         <double>1.000000000000000</double>
        </property>
        <property name="maximum">
         <double>45.000000000000000</double>
        </property>
        <property name="value">
         <double>10.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QLabel" name="labelGroundingCf">
        <property name="text">
         <string>Grounding causation factor (Cat II, missed turn):</string>
        </property>
        <property name="toolTip">
         <string>Powered grounding Category II: the ship fails to turn at a waypoint and runs straight into a shallow area beyond it.  IWRAP p_grounding_no_turn_causation.</string>
