        <string>ship_type_map</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonRow">
     <item>
      <widget class="QPushButton" name="pbImport">
       <property name="toolTip">
        <string>Load a CSV with an mmsi and/or imo column plus a ship_type column (index 0-20, AIS type code 30-89 or a name such as Tanker, Cargo, Passenger) and an optional note column.  The table is created when missing and its rows are replaced.</string>
       </property>
       <property name="text">
        <string>Import CSV...</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pbExport">
       <property name="toolTip">
        <string>Write the current table to a CSV you can edit and import again.</string>
       </property>
       <property name="text">
        <string>Export CSV...</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pbRefresh">
       <property name="text">
        <string>Refresh</string>
       </property>
      </widget>
     </item>
