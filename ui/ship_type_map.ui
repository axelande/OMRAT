<ui version="4.0">
 <class>ShipTypeMapDialog</class>
 <widget class="QDialog" name="ShipTypeMapDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>680</width>
    <height>560</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Custom ship type mapping</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="lblHelp">
     <property name="text">
      <string>Override the AIS ship type per vessel.  The mapping is a table in the AIS database (mmsi, imo, ship_type, note); ship_type is the OMRAT category index 0-20.  When traffic is fetched, an IMO match wins over an MMSI match, which wins over the external vessel lookup and the broadcast AIS type code.  Legs already fetched keep their categories until you run Update AIS again.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="cbEnabled">
     <property name="text">
      <string>Use the custom ship type mapping when fetching AIS traffic</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="lblSchema">
       <property name="text">
        <string>Schema</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="leSchema">
       <property name="toolTip">
        <string>Schema in the AIS database the mapping table lives in (created if missing when you import).</string>
       </property>
       <property name="placeholderText">
        <string>e.g. omrat</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="lblTable">
       <property name="text">
        <string>Table</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QLineEdit" name="leTable">
